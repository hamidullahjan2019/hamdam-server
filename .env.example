# Copy to .env for local runs. NEVER commit a real .env with secrets.
# On Render, set the same keys in the dashboard (Environment tab) instead.

# Port the server listens on (Render sets this automatically — leave unset there)
PORT=8787

# Public URL of this server, no trailing slash (used for /media links)
PUBLIC_URL=http://localhost:8787

# JSON-file store (dev fallback only; ignored when Supabase is configured)
DATA_FILE=./data/db.json

# Front-end origin allowed to call the API (the Netlify site)
ALLOW_ORIGIN=https://fastidious-pixie-4c8929.netlify.app

# Secret for the /api/admin/* endpoints (header X-Admin-Key). Set a long random value.
ADMIN_KEY=

# Supabase project (https://supabase.com/dashboard). When SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are both set, Postgres is used instead of the
# JSON file. SUPABASE_ANON_KEY is needed for Auth OTP e-mails.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dev switches (keep both off in production):
# DEV_OTP=1 returns the OTP code in the /auth/start response (JSON mode only).
DEV_OTP=0
# DEV_GOLD=1 makes /api/checkout grant Gold without billing.
DEV_GOLD=0
